# Claude
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (Meta)
META_WA_TOKEN=EAAxxxxxxx
META_PHONE_NUMBER_ID=123456789012
META_VERIFY_TOKEN=mio_token_segreto_webhook

# Google Calendar
GOOGLE_CREDENTIALS_JSON=./credentials/google_service_account.json
GCAL_SALONE_ID=salone_eccezioni@group.calendar.google.com
# Un calendario per ogni operatore, condiviso con il service account.
# Scrivilo come oggetto JSON su una sola riga: nome operatore → calendar ID.
GCAL_PARRUCCHIERE_IDS={"Simone Big":"cal_id_1@group.calendar.google.com","Simone Jr":"cal_id_2@group.calendar.google.com","Francesco":"cal_id_3@group.calendar.google.com","Andrea":"cal_id_4@group.calendar.google.com","Giava":"cal_id_5@group.calendar.google.com","Bario":"cal_id_6@group.calendar.google.com"}

# PostgreSQL (Render)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/salone_nadia

# Admin pannello
ADMIN_USERNAME=nadia
ADMIN_PASSWORD=password_sicura
SECRET_KEY=chiave_segreta_jwt

# Email: si spedisce dalla casella del salone via SMTP.
# Con Gmail la password NON è quella dell'account ma una "password per le app",
# sedici caratteri, generata da myaccount.google.com dopo aver attivato la
# verifica in due passaggi.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=indirizzo@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Lasciare vuoto: Gmail riscrive comunque il mittente con l'indirizzo autenticato
EMAIL_FROM=

# Numero del salone, dato al cliente quando è troppo tardi per disdire da solo
SALONE_TELEFONO=

# Redis
REDIS_URL=redis://localhost:6379/0

# Configurazione business
SLOT_DURATION_MIN=30
MAX_BOOKING_DAYS_AHEAD=30
CANCEL_POLICY_HOURS=2
INACTIVITY_DAYS=60
MIN_BOOKING_HOURS_AHEAD=2
SESSION_TTL_SECONDS=7200
MAX_HISTORY_MESSAGES=20
